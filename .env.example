# WaveZA Environment Variables - PWA Configuration

# ============================================
# PUSH NOTIFICATIONS & PWA SETUP
# ============================================

# VAPID Keys for Web Push Notifications
# Generate with: npm install -g web-push && web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here
VAPID_EMAIL=your_email@example.com

# Example values (for development only - NEVER use in production):
# VAPID_PUBLIC_KEY=BCdRj1CvyIzXn3I356t7oZGpGalj5CqemFYCSds6DyOR8BHW3uy-yUcvnTaE6NQkCDSPZFMlzvtWKcj6k7LQO5g
# VAPID_PRIVATE_KEY=4yGY_ZSv-sWLFCbzm3tSZkSsi_tLtMQVVQK50bruqSM
# VAPID_EMAIL=hello@waveza.co.za

# ============================================
# DATABASE
# ============================================

DATABASE_URL=sqlite:///mishwrites.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/waveza_db

# ============================================
# SECURITY
# ============================================

SECRET_KEY=your_secret_flask_key_here_min_32_chars
DEBUG=False

# ============================================
# DEVELOPMENT
# ============================================

# Set to 1 for VS Code mobile preview extensions
DEV_PREVIEW=0

# ============================================
# NOTES
# ============================================

# 1. Generate VAPID Keys:
#    npm install -g web-push
#    web-push generate-vapid-keys
#
# 2. Keep VAPID_PRIVATE_KEY secret!
#    Never commit to git
#    Never share in code
#
# 3. Use different keys for:
#    - Development
#    - Staging
#    - Production
#
# 4. After updating .env, restart Flask:
#    python app.py
#
# 5. Verify setup with browser console:
#    navigator.serviceWorker.getRegistrations()
